rules_version = '2';

// Data model
//   users/{uid}                    profile: { displayName, email, createdAt }
//   users/{uid}/courses/{courseId} progress: { completed, quizzes, bookmarks, lastLessonId, updatedAt }
//                                  (problem sets use the same document: solved problems are `completed`)
//   users/{uid}/problems/{problemId}/submissions/{submissionId}
//                                  submission: { language, code, verdict, passed, total, runtimeMs,
//                                                createdAt, failure? } (immutable)
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60
        && data.email is string && data.email == request.auth.token.email
        && data.createdAt is timestamp;
    }

    function validProgress(data) {
      return data.keys().hasOnly(['completed', 'quizzes', 'bookmarks', 'lastLessonId', 'updatedAt'])
        && (!('completed' in data) || (data.completed is map && data.completed.size() <= 1000))
        && (!('quizzes' in data) || (data.quizzes is map && data.quizzes.size() <= 1000))
        && (!('bookmarks' in data) || (data.bookmarks is map && data.bookmarks.size() <= 1000))
        && (!('lastLessonId' in data) || (data.lastLessonId is string && data.lastLessonId.size() <= 200))
        && data.updatedAt is timestamp;
    }

    function optionalString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function validFailure(failure) {
      return failure is map
        && failure.keys().hasOnly(['input', 'output', 'expected', 'error', 'stdout'])
        && optionalString(failure, 'input', 2100)
        && optionalString(failure, 'output', 2100)
        && optionalString(failure, 'expected', 2100)
        && optionalString(failure, 'error', 2100)
        && optionalString(failure, 'stdout', 2100);
    }

    function validSubmission(data) {
      return data.keys().hasOnly(['language', 'code', 'verdict', 'passed', 'total', 'runtimeMs', 'createdAt', 'failure'])
        && data.language in ['javascript', 'typescript', 'python']
        && data.code is string && data.code.size() <= 50000
        && data.verdict in ['Accepted', 'Wrong Answer', 'Runtime Error', 'Time Limit Exceeded', 'Compile Error']
        && data.total is int && data.total >= 0 && data.total <= 1000
        && data.passed is int && data.passed >= 0 && data.passed <= data.total
        && data.runtimeMs is number && data.runtimeMs >= 0
        && data.createdAt == request.time
        && (!('failure' in data) || validFailure(data.failure));
    }

    match /users/{uid} {
      // The profile is written at sign-up, before the email is verified.
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if false;

      match /courses/{courseId} {
        allow read: if isOwner(uid) && isVerified();
        allow create, update: if isOwner(uid) && isVerified()
          && courseId.size() <= 64
          && validProgress(request.resource.data);
        allow delete: if isOwner(uid) && isVerified();
      }

      match /problems/{problemId}/submissions/{submissionId} {
        allow read: if isOwner(uid) && isVerified();
        allow create: if isOwner(uid) && isVerified()
          && problemId.size() <= 128
          && validSubmission(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

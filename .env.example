# Copy to .env.local for development and to .env.production.local for deploys (see README).
#
# Local development against the emulators (`yarn emulators`) needs no real project:
#   VITE_FIREBASE_API_KEY=demo-key
#   VITE_FIREBASE_AUTH_DOMAIN=demo-bytearchitect.firebaseapp.com
#   VITE_FIREBASE_PROJECT_ID=demo-bytearchitect
#   VITE_FIREBASE_APP_ID=demo-app-id
#   VITE_USE_EMULATORS=true

# Firebase web app config (Project settings → General → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# true = use the local Auth + Firestore emulators instead of the real project
VITE_USE_EMULATORS=false

{
  "name": "bytearchitect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
